---
extends: default

rules:
  truthy:
    # Allow GitHub Actions workflow triggers
    allowed-values: ['true', 'false', 'yes', 'no', 'on', 'off']
  comments-indentation: disable

ignore: |
  .github/workflows/release.yml
  .github/workflows/ci.yml
  examples/ci-cd/
  config.yaml
  templates/helm/weave-stack/templates/
