# Weave CLI Configuration (Optional)
# Only create this file if you need to customize default behavior
# By default, Weave CLI works with just .env credentials!

---
# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

databases:
  # Default database type (auto-detected from environment)
  # Options: weaviate-cloud, weaviate-local, mock
  # Default: weaviate-cloud (if WEAVIATE_URL set), otherwise mock
  default: weaviate-cloud

  vector_databases:
    # Weaviate Cloud Configuration
    - name: weaviate-cloud
      type: weaviate-cloud
      url: ${WEAVIATE_URL}
      api_key: ${WEAVIATE_API_KEY}
      openai_api_key: ${OPENAI_API_KEY}
      timeout: 10                       # Timeout in seconds (default: 10s)

      # Default collection names (override if needed)
      collections:
        - name: WeaveDocs           # Default text collection
          type: text
          description: Main text documents collection
        - name: WeaveImages         # Default image collection
          type: image
          description: Image documents collection

    # Weaviate Local Configuration
    - name: weaviate-local
      type: weaviate-local
      url: http://localhost:8080    # Default local URL
      openai_api_key: ${OPENAI_API_KEY}
      timeout: 10                   # Timeout in seconds (default: 10s)

      collections:
        - name: WeaveDocs
          type: text
          description: Local text documents collection
        - name: WeaveImages
          type: image
          description: Local image documents collection

    # Mock Database (for testing)
    - name: mock
      type: mock
      enabled: true
      simulate_embeddings: true
      embedding_dimension: 384
      timeout: 10                   # Timeout in seconds (default: 10s)

      collections:
        - name: WeaveDocs
          type: text
          description: Mock text collection for testing
        - name: WeaveImages
          type: image
          description: Mock image collection for testing

# =============================================================================
# ADVANCED FEATURES (Optional)
# =============================================================================

# Custom collection schemas directory
# schemas_dir: ./schemas

# Batch processing defaults
batch:
  parallel_workers: 3              # Number of parallel workers
  retry_attempts: 3                # Retry failed documents
  chunk_size: 500                  # Documents per batch

# PDF processing defaults
pdf:
  extract_images: true             # Extract images from PDFs
  skip_all_images: false           # Text-only mode
  skip_small_images: false         # Don't process small images
  image_quality: 85                # JPEG quality (1-100)
  max_image_size: 2048             # Max image dimension (pixels)

# AI agents configuration
ai:
  model: gpt-4o                    # Default LLM model
  max_retries: 3                   # Max retries for LLM calls
  timeout: 300                     # Timeout in seconds
  enable_opik: true                # Enable Opik observability

# Output preferences
output:
  format: text                     # Options: text, json, yaml
  no_color: false                  # Disable colored output
  verbose: false                   # Enable verbose logging
  show_tips: true                  # Show helpful tips

# =============================================================================
# CUSTOM COLLECTION SCHEMAS (Optional)
# =============================================================================
# Define reusable schemas for creating collections
# Usage: weave cols create MyCollection --schema RagMeDocs

# Uncomment and customize as needed:
# databases:
#   schemas:
#     - name: RagMeDocs
#       schema:
#         class: RagMeDocs
#         vectorizer: text2vec-openai
#         properties:
#           - name: url
#             datatype: [text]
#             description: Source URL
#           - name: text
#             datatype: [text]
#             description: Document content
#           - name: metadata
#             datatype: [text]
#             description: Additional metadata (JSON)

# =============================================================================
# NOTES
# =============================================================================
#
# Quick Start:
# - You don't need this file to get started!
# - Just set credentials in .env and run commands
# - Create config.yaml only if you need customization
#
# Configuration Precedence:
# 1. Command-line flags (highest priority)
# 2. Environment variables
# 3. config.yaml
# 4. Built-in defaults (lowest priority)
#
# Environment Variable Reference:
# - VECTOR_DB_TYPE: Database type override
# - WEAVIATE_URL: Weaviate instance URL
# - WEAVIATE_API_KEY: Weaviate authentication
# - OPENAI_API_KEY: OpenAI for embeddings/LLM
# - OPENAI_MODEL: Override default model
# - WEAVE_MCP_STDIO_PATH: Path to MCP binary
# - OPIK_API_KEY: Opik observability
#
# For more details, see: https://github.com/maximilien/weave-cli
