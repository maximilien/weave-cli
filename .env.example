# Weave CLI Secrets Configuration
# Copy this file to .env and add your API keys

# =============================================================================
# WEAVIATE CLOUD CREDENTIALS (Required for cloud usage)
# =============================================================================

# Your Weaviate Cloud URL
# Get from: https://console.weaviate.cloud/
WEAVIATE_URL="https://your-cluster-id.c0.us-west3.gcp.weaviate.cloud"

# Your Weaviate Cloud API Key
# Get from: https://console.weaviate.cloud/
WEAVIATE_API_KEY="your-weaviate-api-key-here"

# =============================================================================
# MONGODB ATLAS CREDENTIALS (Alternative to Weaviate)
# =============================================================================

# MongoDB Atlas Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/?appName=appname
# Get from: https://cloud.mongodb.com/ > Connect > Drivers
# MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?appName=weave-cli"

# MongoDB Database Name
# MONGODB_DATABASE="weave-cli"

# =============================================================================
# MILVUS CREDENTIALS (Alternative to Weaviate/MongoDB/Supabase)
# =============================================================================

# Milvus Local (Docker/Podman)
# MILVUS_LOCAL_ADDRESS="localhost:19530"
# MILVUS_LOCAL_DATABASE="default"

# Milvus Cloud (Zilliz)
# Get from: https://cloud.zilliz.com/
# MILVUS_CLOUD_ADDRESS="your-cluster.aws-us-west-2.vectordb.zillizcloud.com:19530"
# MILVUS_CLOUD_USERNAME="db_admin"
# MILVUS_CLOUD_PASSWORD="your-secure-password"
# MILVUS_CLOUD_DATABASE="default"

# =============================================================================
# SUPABASE CREDENTIALS (Alternative to Weaviate/MongoDB/Milvus)
# =============================================================================

# Supabase PostgreSQL Connection String
# Format (direct - requires IPv6):
# postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres
#
# Format (connection pooler - IPv4 compatible):
# postgresql://postgres.[project-ref]:[password]@aws-0-us-west-1.pooler.supabase.com:6543/postgres
#
# Get from: Project Settings > Database > Connection String
# SUPABASE_DATABASE_URL="postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres"

# Supabase API Key (optional - anon/public or service_role)
# Get from: Project Settings > API
# SUPABASE_DATABASE_KEY="your-supabase-api-key-here"

# =============================================================================
# AI/LLM PROVIDER CREDENTIALS (Required for AI agents and embeddings)
# =============================================================================

# OpenAI API Key (for embeddings and AI agents)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-proj-your-openai-api-key-here"

# Opik API Key (optional - for LLM observability)
# Get from: https://www.comet.com/site/products/opik/
# OPIK_API_KEY="your-opik-api-key-here"
# OPIK_WORKSPACE="your-workspace"
# OPIK_PROJECT_NAME="weave-cli"
# OTEL_EXPORTER_OTLP_ENDPOINT="https://www.comet.com/opik/api/v1/private/otel/v1/traces"

# =============================================================================
# WEAVE-MCP INTEGRATION (Optional - for AI agents)
# =============================================================================

# Path to weave-mcp stdio binary
# WEAVE_MCP_STDIO_PATH="/path/to/weave-mcp/bin/weave-mcp-stdio"

# =============================================================================
# NOTES
# =============================================================================
#
# Getting Started (Quickest):
# 1. Set WEAVIATE_URL, WEAVIATE_API_KEY, OPENAI_API_KEY
# 2. Run: weave health check
# 3. That's it! No config.yaml needed.
#
# For Local Development:
# - Run local Weaviate on http://localhost:8080
# - Only OPENAI_API_KEY needed for embeddings
# - Set VECTOR_DB_TYPE=weaviate-local (optional)
#
# For MongoDB Atlas:
# - Use MongoDB Atlas Vector Search (free M0 tier available)
# - Set MONGODB_URI and MONGODB_DATABASE
# - Set VECTOR_DB_TYPE=mongodb
# - Requires vector search index setup (see docs/mongodb/ATLAS_SETUP.md)
#
# For Milvus Local:
# - Use local Milvus via Docker/Podman (see docs/milvus/LOCAL_SETUP.md)
# - Start with: ./tools/vdb/local/milvus.sh start
# - Set MILVUS_LOCAL_ADDRESS (default: localhost:19530)
# - Set VECTOR_DB_TYPE=milvus-local
# - Requires Docker or Podman installed
#
# For Milvus Cloud (Zilliz):
# - Use managed Zilliz Cloud (free tier available)
# - Set MILVUS_CLOUD_ADDRESS, MILVUS_CLOUD_USERNAME, MILVUS_CLOUD_PASSWORD
# - Set VECTOR_DB_TYPE=milvus-cloud
# - See docs/milvus/CLOUD_SETUP.md for setup guide
#
# For Supabase:
# - Use Supabase PGVector (free tier available)
# - Set SUPABASE_DATABASE_URL (and optionally SUPABASE_DATABASE_KEY)
# - Set VECTOR_DB_TYPE=supabase
# - Requires pgvector extension enabled (see docs/supabase/README.md)
# - Use connection pooler URL for IPv4 compatibility
#
# For Testing:
# - Use mock database (no credentials needed)
# - Set VECTOR_DB_TYPE=mock
# - Perfect for testing without external services
#
# Advanced Configuration:
# - Create config.yaml for fine-tuning (see config.yaml.example)
# - Override collection names, schemas, batch sizes, etc.
#
# Security:
# - Never commit .env to version control
# - Rotate API keys regularly
# - Use separate keys for dev/staging/production
