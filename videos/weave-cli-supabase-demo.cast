[0.000312, "o", "\u001b[0;34mð Page 11: Hybrid Search (Vector + BM25)\u001b[0m\r\r\n\r\r\nCombine semantic and keyword search:\r\r\n\r\r\n$ weave cols q SupabaseDemoCol \"CLI tool\" --hybrid --supabase\r\r\n"]
[0.021261, "o", "Error: unknown flag: --hybrid\r\r\n"]
[0.002159, "o", "Usage:\r\r\n  weave collection query COLLECTION \"query text\" [flags]\r\r\n\r\r\nAliases:\r\r\n  query, q\r\r\n\r\r\nFlags:\r\r\n      --bm25              Use BM25 keyword search instead of semantic search (default: false)\r\r\n  -d, --distance float    Maximum distance threshold for results\r\r\n  -h, --help              help for query\r\r\n  -m, --search-metadata   Also search in metadata fields (default: false)\r\r\n  -k, --top_k int         Number of top results to return (default: 5) (default 5)\r\r\n\r\r\nGlobal Flags:\r\r\n      --all                       operate on all configured vector databases\r\r\n      --config string             config file (default is ./config.yaml)\r\r\n      --env string                env file (default is ./.env)\r\r\n      --json                      output results in JSON format\r\r\n      --mock                      use mock vector database\r\r\n      --no-color                  disable colored output\r\r\n      --no-confirm                skip confirmation prompts for destructive operations\r\r\n      --no-tips                   sup"]
[0.000482, "o", "press helpful tips an"]
[0.000306, "o", "d suggestions\r\r\n      --no-truncate               show all data without truncation\r\r\n  -q, --quiet                     quiet output (minimal messages)\r\r\n      --quiet-config              suppress config location information\r\r\n      --supabase                  use Supabase PGVector database\r\r\n      --timeout string            timeout for vector DB operations (e.g., 5s, 10s, 30s; default: 10s)\r\r\n      --vdb string                alias for --vector-db-type\r\r\n      --vector-db-type string     override VECTOR_DB_TYPE (weaviate-cloud|weaviate-local|mock|supabase)\r\r\n  -v, --verbose                   verbose output\r\r\n      --weaviate                  use Weaviate vector database (weaviate-cloud or weaviate-local)\r\r\n      --weaviate-api-key string   override WEAVIATE_API_KEY\r\r\n      --weaviate-url string       override WEAVIATE_URL\r\r\n\r\r\n"]
[0.000058, "o", "\u001b[1;33mHybrid search combines vector + BM25\u001b[0m\r\r\n\r\r\nPress Enter to continue..."]
