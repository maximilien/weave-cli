[0.010907, "o", "================================================\r\r\n  Weave CLI - Supabase Integration Demo\r\r\n  PostgreSQL + pgvector Backend\r\r\n================================================\r\r\n\r\r\n\u001b[0;34mð Page 1: Supabase as Vector Database\u001b[0m\r\r\n\r\r\n"]
[0.000024, "o", "Weave CLI supports multiple vector database backends:\r\r\n  • Weaviate Cloud\r\r\n  • Weaviate Local\r\r\n  • Supabase (PostgreSQL + pgvector) ⭐\r\r\n  • Mock Database\r\r\n\r\r\nThis demo shows Supabase integration (EXPERIMENTAL)\r\r\n\r\r\nPress Enter to continue..."]
[3.004962, "o", "\r\r\n"]
[0.00214, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000168, "o", "\u001b[0;34mð Page 2: Supabase Configuration\u001b[0m\r\r\n\r\r\nConfigure Supabase connection:\r\r\n\r\r\n"]
[0.002158, "o", "export SUPABASE_DATABASE_URL=\"postgres://postgres:[password]@db.[project].supabase.co:6543/postgres\"\r\r\nexport SUPABASE_DATABASE_KEY=\"your-supabase-anon-key\"\r\r\nexport VECTOR_DB_TYPE=\"supabase\"\r\r\n\r\r\n# Or use interactive setup\r\r\nweave config create --database-type supabase\r\r\n"]
[0.000112, "o", "\r\r\n"]
[0.000048, "o", "\u001b[1;33mNote: Use transaction pooler (port 6543) for IPv4 compatibility\u001b[0m\r\r\n\r\r\nPress Enter to continue..."]
