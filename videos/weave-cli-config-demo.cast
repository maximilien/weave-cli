[0.030855, "o", "================================================\r\r\n  Weave CLI - Configuration Management Demo\r\r\n================================================\r\r\n\r\r\n\u001b[0;34mð Page 1: View Current Configuration\u001b[0m\r\r\n\r\r\n$ weave config show\r\r\n"]
[0.025059, "o", "\u001b[36;1m═══ Default Database Configuration ═══\r\r\n\u001b[0m\r\r\n\u001b[36;1mType: weaviate-cloud\r\r\n\u001b[0m\r\r\n\u001b[32mð Weaviate Cloud Configuration\r\r\n\u001b[0m  URL: https://c4cclmintjcxv7wj7eetw.c0.us-west3.gcp.weaviate.cloud\r\r\n\u001b[32m  API Key: ***hidden***\r\r\n\u001b[0m\r\r\n\u001b[36;1m═══ Configuration Sources ═══\r\r\n\u001b[0m\u001b[36mð Location: Local (current directory)\r\r\n\u001b[0m\r\r\nConfig file: config.yaml\r\r\nEnv file: /Users/maximilien/github/maximilien/weave-cli/.env\r\r\n\r\r\n\u001b[36;1m═══ Schema Configuration ═══\r\r\n\u001b[0mSchemas directory: not configured\r\r\nConfigured schemas: 0\r\r\n"]
[0.000904, "o", "\r\r\nPress Enter to continue..."]
[0.00083, "o", "\r\r\n"]
[0.004853, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000302, "o", "\u001b[0;34mð Page 2: Interactive Configuration Setup\u001b[0m\r\r\n\r\r\nThe 'weave config create --env' command provides interactive setup:\r\r\n\r\r\n$ weave config create --env\r\r\n\r\r\n\u001b[1;33mThis command prompts for:\u001b[0m\r\r\n  - WEAVIATE_URL\r\r\n  - WEAVIATE_API_KEY\r\r\n"]
[0.00001, "o", "  - OPENAI_API_KEY\r\r\n\r\r\n\u001b[1;33m(Skipping interactive setup in this demo - you already have config)\u001b[0m\r\r\n\r\r\nPress Enter to continue..."]
[0.000364, "o", "\r\r\n"]
[0.003951, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000441, "o", "\u001b[0;34mð Page 3: Verify Configuration\u001b[0m\r\r\n\r\r\n$ weave config show\r\r\n"]
[0.023718, "o", "\u001b[36;1m═══ Default Database Configuration ═══\r\r\n\u001b[0m\r\r\n\u001b[36;1mType: weaviate-cloud\r\r\n\u001b[0m\r\r\n\u001b[32mð Weaviate Cloud Configuration\r\r\n\u001b[0m  URL: https://c4cclmintjcxv7wj7eetw.c0.us-west3.gcp.weaviate.cloud\r\r\n\u001b[32m  API Key: ***hidden***\r\r\n\u001b[0m\r\r\n\u001b[36;1m═══ Configuration Sources ═══\r\r\n\u001b[0m\u001b[36mð Location: Local (current directory)\r\r\n\u001b[0m\r\r\nConfig file: config.yaml\r\r\nEnv file: /Users/maximilien/github/maximilien/weave-cli/.env\r\r\n\r\r\n\u001b[36;1m═══ Schema Configuration ═══\r\r\n\u001b[0mSchemas directory: not configured\r\r\nConfigured schemas: 0\r\r\n"]
[0.001053, "o", "\r\r\nPress Enter to continue..."]
[0.000345, "o", "\r\r\n"]
[0.005055, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.00036, "o", "\u001b[0;34mð Page 4: Environment Variable Configuration\u001b[0m\r\r\n\r\r\nYou can also configure using environment variables:\r\r\n\r\r\n"]
[0.004743, "o", "export VECTOR_DB_TYPE=\"weaviate-cloud\"\r\r\nexport WEAVIATE_URL=\"https://your-instance.weaviate.cloud\"\r\r\nexport WEAVIATE_API_KEY=\"your-api-key\"\r\r\nexport OPENAI_API_KEY=\"sk-proj-your-key\"\r\r\n\r\r\n# Verify configuration\r\r\nweave config show\r\r\n"]
[0.000323, "o", "\r\r\nPress Enter to continue..."]
[0.000334, "o", "\r\r\n"]
[0.004007, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000239, "o", "\u001b[0;34mð Page 5: Global vs Local Configuration\u001b[0m\r\r\n\r\r\nWeave CLI supports both global and local configuration:\r\r\n\r\r\nLocal (current directory):\r\r\n  .env\r\r\n"]
[0.000009, "o", "  config.yaml\r\r\n\r\r\nGlobal (user-wide):\r\r\n  ~/.weave-cli/.env\r\r\n  ~/.weave-cli/config.yaml\r\r\n\r\r\nCreate global configuration:\r\r\n$ weave config create --env --global\r\r\n\r\r\nSync local to global:\r\r\n"]
[0.000197, "o", "$ weave config sync\r\r\n\r\r\nPress Enter to continue..."]
[0.00013, "o", "\r\r\n"]
[0.004698, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.000386, "o", "\u001b[0;34mð Page 6: Configuration Precedence\u001b[0m\r\r\n\r\r\nConfiguration sources (highest to lowest priority):\r\r\n\r\r\n  1. Command-line flags\r\r\n     weave query --model gpt-4\r\r\n"]
[0.000022, "o", "\r\r\n  2. Environment variables\r\r\n"]
[0.000241, "o", "     export OPENAI_MODEL=gpt-4\r\r\n\r\r\n  3. config.yaml (optional)\r\r\n     For advanced customization\r\r\n\r\r\n  4. Built-in defaults\r\r\n     weaviate-cloud, gpt-4o, etc.\r\r\n\r\r\nPress Enter to continue..."]
[0.000163, "o", "\r\r\n"]
[0.005729, "o", "\u001b[3J\u001b[H\u001b[2J\u001b[0;34mð Page 7: Install weave-mcp for REPL Mode\u001b[0m\r\r\n\r\r\nFor AI-powered REPL mode, install weave-mcp:\r\r\n\r\r\n$ weave config update --weave-mcp\r\r\n\r\r\nThis downloads and installs the weave-mcp binary for\r\r\nnatural language interactions in REPL mode.\r\r\n\r\r\nPress Enter to see example (or Ctrl+C to skip)..."]
[0.000704, "o", "\r\r\n"]
[0.024295, "o", "\u001b[36;1m═══ Weave MCP Binary Installer ═══\r\r\n\u001b[0m\r\r\n\u001b[36mð Platform: darwin-arm64\r\r\n\u001b[0m\r\r\n\u001b[33m⚠️  weave-mcp is already installed at: /Users/maximilien/.local/bin/weave-mcp-stdio\r\r\n\u001b[0m\r\r\nDo you want to reinstall? (y/N): "]
