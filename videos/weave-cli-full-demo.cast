[0.000108, "o", "\u001b[1;33m$ if [ -f images/weave-cli_1.png ]; then if ./bin/weave docs create WeaveImages images/weave-cli_1.png >/dev/null 2>&1; then echo '✅ Image document created successfully'; else echo 'ℹ️ Image too large for embedding model - this is expected for large images'; fi; else echo 'ℹ️ No image file found - skipping image document creation'; fi\u001b[0m\r\n"]
