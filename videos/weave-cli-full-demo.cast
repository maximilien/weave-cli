[1.020767, "o", "\u001b[34;1m🔧 Default Database Configuration\r\n\u001b[0m\r\n\u001b[36;1mType: weaviate-cloud\r\n\u001b[0m\r\n\u001b[32m🌐 Weaviate Cloud Configuration\r\n\u001b[0m  URL: https://c4cclmintjcxv7wj7eetw.c0.us-west3.gcp.weaviate.cloud\r\n\u001b[32m  API Key: ***hidden***\r\n\u001b[0m  Collections:\r\n    - WeaveDocs (text)\r\n    - WeaveImages (image)\r\n\r\n\u001b[34;1m🔧 Configuration Sources\r\n\u001b[0mConfig file: \r\nEnv file: \r\n\r\n\u001b[34;1m🔧 Schema Configuration\r\n\u001b[0mSchemas directory: ./schemas\r\nConfigured schemas: 5\r\n\r\n"]
[0.000027, "o", "  1. RagMeDocs\r\n  2. RagMeImages\r\n  3. WeaveDocs\r\n  4. WeaveImages\r\n  5. TestSchema\r\n\r\n\u001b[36m💡 Use 'weave config show-schema <name>' to view schema details\r\n\u001b[0m"]
