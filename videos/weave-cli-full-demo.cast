[0.000074, "o", "\u001b[1;33m$ if [ -f README.md ]; then ./bin/weave docs create WeaveDocs README.md || echo 'Document creation failed - continuing demo'; else echo 'README.md not found - creating sample document'; echo '# Sample Document\r\n\r\nThis is a sample document for the demo.\r\n\r\n## Features\r\n- Vector embeddings\r\n- Semantic search\r\n"]
