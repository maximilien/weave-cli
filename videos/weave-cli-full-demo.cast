[0.000106, "o", "\u001b[0;32m═══════════════════════════════════════════════════════════════\u001b[0m\r\n\r\n"]
[2.004878, "o", "\u001b[0;34m💻 Create Text Document\u001b[0m\r\n\u001b[1;33m$ if [ -f README.md ]; then ./bin/weave docs create WeaveDocs README.md; else echo 'README.md not found - creating sample document'; echo '# Sample Document\r\n\r\nThis is a sample document for the demo.' > README.md && ./bin/weave docs create WeaveDocs README.md; fi\u001b[0m\r\n"]
[10.52421, "o", "\u001b[32m✅ Successfully created document: README.md (6 chunks)\r\n\u001b[0m"]
[0.002289, "o", "\r\n"]
[2.012175, "o", "\u001b[0;34m💻 Create Image Document\u001b[0m\r\n\u001b[1;33m$ if ./bin/weave docs create WeaveImages images/weave-cli_1.png >/dev/null 2>&1; then echo '✅ Image document created successfully'; else echo 'ℹ️ Image too large for embedding model - this is expected for large images'; fi\u001b[0m\r\n"]
[1.544825, "o", "✅ Image document created successfully\r\n\r\n"]
[2.006557, "o", "\r\n\u001b[0;32m═══════════════════════════════════════════════════════════════\u001b[0m\r\n"]
