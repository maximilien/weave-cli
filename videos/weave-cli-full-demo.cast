[1.030637, "o", "\u001b[34;1m🔧 Default Database Configuration\r\n\u001b[0m\r\n\u001b[36;1mType: weaviate-cloud\r\n\u001b[0m\r\n\u001b[32m🌐 Weaviate Cloud Configuration\r\n\u001b[0m  URL: https://c4cclmintjcxv7wj7eetw.c0.us-west3.gcp.weaviate.cloud\r\n\u001b[32m  API Key: ***hidden***\r\n\u001b[0m  Collections:\r\n    - WeaveMcpDocs (text)\r\n    - WeaveMcpImages (image)\r\n    - WeaveMcpDocs_test (text)\r\n\r\n\u001b[34;1m🔧 Configuration Sources\r\n\u001b[0mConfig file: /Users/maximilien.ai/github/maximilien/weave-cli/config.yaml\r\n"]
