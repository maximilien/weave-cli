[0.007743, "o", "\u001b[36;1mð Available Embedding Models\u001b[0;22m\r\r\n\r\r\n\u001b[33;1mð¢ AWS Bedrock\r\r\n\u001b[0m\r\r\n\u001b[32m  ð amazon.titan-embed-text-v1\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ Cohere\r\r\n\u001b[0m\r\r\n\u001b[32m  ð embed-english-light-v3.0\u001b[0m\r\r\n\u001b[32m  ð embed-english-v3.0\u001b[0m\r\r\n\u001b[32m  ð embed-multilingual-v3.0\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ Google PaLM\r\r\n\u001b[0m\r\r\n\u001b[32m  ð textembedding-gecko@001\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ Hugging Face\r\r\n\u001b[0m\r\r\n\u001b[32m  ð sentence-transformers/all-MiniLM-L6-v2\u001b[0m\r\r\n\u001b[32m  ð sentence-transformers/all-mpnet-base-v2\u001b[0m\r\r\n\u001b[32m  ð sentence-transformers/paraphrase-MiniLM-L6-v2\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ Image Recognition\r\r\n\u001b[0m\r\r\n\u001b[32m  ð¼️  resnet50\u001b[0m\u001b[37m (image)\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ Jina AI\r\r\n\u001b[0m\r\r\n\u001b[32m  ð jina-embeddings-v2-base-en\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ OpenAI\r\r\n\u001b[0m\r\r\n\u001b[32m  ð ada\u001b[0m\r\r\n\u001b[32m  ð babbage\u001b[0m\r\r\n\u001b[32m  ð curie\u001b[0m\r\r\n\u001b[32m  ð davinci\u001b[0m\r\r\n\u001b[32m  ð text-embedding-3-large\u001b[0m\r\r\n\u001b[32m  ð tex"]
[0.000041, "o", "t-embedding-3-small\u001b[0m\r\r\n\u001b[32m  ð text-embedding-ada-002\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ OpenAI CLIP\r\r\n\u001b[0m\r\r\n\u001b[32m  ð clip-vit-base-patch32\u001b[0m\u001b[37m (multimodal)\u001b[0m\r\r\n\r\r\n\u001b[33;1mð¢ Weaviate\r\r\n\u001b[0m\r\r\n\u001b[32m  ð weaviate-default\u001b[0m\r\r\n\r\r\n\u001b[36mð¡ Usage:\u001b[0m\r\r\n   Use --embedding-model flag when creating collections:\r\r\n   weave cols create MyCollection --embedding-model text-embedding-3-small\r\r\n\r\r\n   Filter by database type:\r\r\n   weave embeddings list --database supabase\r\r\n"]
[0.00003, "o", "\r\r\n   Show compatibility information:\r\r\n   weave embeddings list --show-compatibility\r\r\n"]
[0.000198, "o", "\r\r\nPress Enter to continue..."]
[0.00001, "o", "\r\r\n"]
