[0.000217, "o", "\u001b[0;34mð Page 13: Batch Processing\u001b[0m\r\r\n\r\r\nBatch process documents from a directory:\r\r\n\r\r\n$ weave docs batch --directory ./docs --collection MyCol --parallel 3\r\r\n\r\r\n\u001b[1;33m(Example command - not running in demo)\u001b[0m\r\r\n\r\r\nFeatures:\r\r\n  • Process entire directories\r\r\n  • Parallel processing with configurable workers\r\r\n  • Automatic retry on failures\r\r\n  • Progress tracking\r\r\n\r\r\nPress Enter to continue..."]
[3.003349, "o", "\r\r\n"]
[0.002262, "o", "\u001b[3J\u001b[H\u001b[2J"]
