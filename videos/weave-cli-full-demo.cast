[2.009283, "o", "\u001b[0;34m💻 Delete Document with Force\u001b[0m\r\n\u001b[1;33m$ ./bin/weave docs delete WeaveDocs --name README.md --force\u001b[0m\r\n"]
[1.193613, "o", "\u001b[32m✅ ✅ Successfully deleted 1 document(s) with filename 'README.md'\r\n\u001b[0m\u001b[32m✅ Successfully deleted document(s)\r\n\u001b[0m"]
