[0.000055, "o", "\u001b[0;32m═══════════════════════════════════════════════════════════════\u001b[0m\r\n\r\n"]
[2.008341, "o", "\u001b[0;34m💻 Create Text Document\u001b[0m\r\n"]
[0.00005, "o", "\u001b[1;33m$ if [ -f README.md ]; then ./bin/weave docs create WeaveDocs README.md || echo 'Document creation failed - continuing demo'; else echo 'README.md not found - creating sample document'; echo '# Sample Document\r\n\r\nThis is a sample document for the demo.\r\n\r\n"]
[0.000027, "o", "## Features\r\n- Vector embeddings\r\n- Semantic search\r\n- Document management' > README.md && ./bin/weave docs create WeaveDocs README.md || echo 'Document creation failed - continuing demo'; fi\u001b[0m\r\n"]
