[0.000016, "o", "\u001b[1;33m$ if [ -f tests/fixtures/ragme-io.pdf ]; then ./bin/weave docs create WeaveDocs tests/fixtures/ragme-io.pdf || echo 'PDF document creation failed - continuing demo'; else echo 'ℹ️ No PDF file found - skipping PDF document creation'; fi\u001b[0m\r\n"]
